#!/usr/bin/env python3
import sys
import re

with open('requirements.txt', 'r') as f:
    lines = f.readlines()

errors = []
for i, line in enumerate(lines, 1):
    line = line.strip()
    if not line or line.startswith('#') or line.startswith('-'):
        continue
    if not re.match(r'^[a-zA-Z0-9][a-zA-Z0-9._-]*(\[[a-zA-Z0-9,_-]+\])?(([=<>!]=?|~=)[0-9][0-9a-zA-Z._*]*)?$', line):
        errors.append(f'Línea {i}: "{line}"')

if errors:
    print('❌ requirements.txt tiene líneas inválidas:')
    for e in errors:
        print(f'  {e}')
    sys.exit(1)

print('✅ requirements.txt OK')
